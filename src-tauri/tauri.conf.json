{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agent-dock",
  "version": "0.1.0",
  "identifier": "com.user.agent-dock",
  "build": {
    "beforeDevCommand": "node scripts/serve.cjs",
    "devUrl": "http://localhost:1428",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Dock Widget",
        "width": 380,
        "height": 188,
        "resizable": true,
        "minWidth": 320,
        "minHeight": 54,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
